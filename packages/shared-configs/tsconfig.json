{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "target": "ES2020",
    "esModuleInterop": true,

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,

    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*","src/*"],
  "exclude": ["node_modules", "dist"]
}
