{
  "name": "@repo/shared-config",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "./src/constants": {
      "import": "./dist/esm/constants/index.js",
      "require": "./dist/cjs/constants/index.js",
      "types": "./dist/types/constants/index.d.ts"
    },
    "./src/schemas": {
      "import": "./dist/esm/schemas/index.js",
      "require": "./dist/cjs/schemas/index.js",
      "types": "./dist/types/schemas/index.d.ts"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "dev": "tsc -w",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lucide-react": "^0.513.0",
    "zod": "^3.25.55"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "22.8.2",
    "tsup": "^8.5.0",
    "typescript": "5.6.3"
  }
}
